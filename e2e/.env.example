# Model and key for the e2e lane.
#
# Copy this file to `.env` and fill in your own values. `.env` is gitignored
# (as is `.env.local`), so nothing here is ever committed.
#
#     cp .env.example .env
#
# Only the three variables below are read. The endpoint must be
# OpenAI-compatible, because e2e's agent drives the browser through it.
#
# The same endpoint is handed to the instance under test as well: opening a
# session requires sending one message, so the instance's own agent needs a
# model too. It speaks the Anthropic dialect and appends `/v1/messages` itself,
# which is why the launcher strips a trailing `/v1` before passing it on.

# Base URL of the OpenAI-compatible API, up to and including `/v1`.
#
# Ollama Cloud (the setup this lane was built against):
#   E2E_LLM_BASE_URL=https://ollama.com/v1
# A local Ollama would be `http://localhost:11434/v1` — NOT
# `http://localhost:11434/api/chat`, which is Ollama's own native protocol and
# cannot be parsed by the OpenAI-compatible client.
E2E_LLM_BASE_URL=https://ollama.com/v1

# API key for that endpoint.
E2E_LLM_API_KEY=replace-me

# Model id to drive the agent with. It must support tool calls; image input is
# also needed for the steps that read the screen visually.
E2E_LLM_MODEL=deepseek-v4.1-flash
