{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "*.json",
      "!**/.dsh-meow",
      "!**/lib",
      "!**/dist",
      "!tsdown.config.ts",
      "!vitest.config.ts",
      "!tsconfig.json",
      "!tsconfig.build.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        "noConfusingVoidType": "off"
      },
      "a11y": {
        "useSemanticElements": "off"
      }
    }
  }
}
